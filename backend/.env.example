# Copy to .env and fill in. NEVER commit .env (it is git-ignored).

# Local Docker Postgres (see README later) or Supabase "Session pooler" (port 5432).
DB_URL=jdbc:postgresql://localhost:5433/darksauce
DB_USER=darksauce
DB_PASSWORD=localdev

# Where your React app runs (CORS allows only this origin)
FRONTEND_ORIGIN=http://localhost:5173

# Required: at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=
# false only for local http development. MUST be true in production (https).
COOKIE_SECURE=false

# Added in later phases:
# SUPABASE_URL=                  phase 4
# SUPABASE_SERVICE_ROLE_KEY=     phase 4 (server only, never in the frontend)
