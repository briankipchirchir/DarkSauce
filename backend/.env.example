# Copy to .env and fill in. NEVER commit .env (it is git-ignored).

# Supabase -> Connect -> "Session pooler" (port 5432). Not the transaction pooler (6543).
# Host looks like aws-0-<region>.pooler.supabase.com
DB_URL=jdbc:postgresql://localhost:5433/darksauce
DB_USER=darksauce
DB_PASSWORD=localdev
FRONTEND_ORIGIN=http://localhost:5173

# Added in later phases (leave out for now):
# JWT_SECRET=            phase 2: generate with: openssl rand -base64 48
# SUPABASE_URL=          phase 4
# SUPABASE_SERVICE_ROLE_KEY=   phase 4 (server only, never in the frontend)
